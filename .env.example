
# ==== PostgreSQL ====

POSTGRES_DB=bittencourt_academy
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# PostgreSQL port exposed on the host machine.
# Change only if port 5432 is already in use.
# Does not affect the internal container port.
POSTGRES_PORT=5432


# ==== RabbitMQ ====

RABBITMQ_DEFAULT_USER=academy
RABBITMQ_DEFAULT_PASS=change_me


# ==== Main Service ====

# API port exposed on the host machine.
# Change only if port 8080 is already in use.
# Does not affect the internal container port.
MAIN_SERVICE_PORT=8080


# ==== Email Service ====

# Email service port exposed on the host machine.
# Change only if port 8081 is already in use.
# Does not affect the internal container port.
EMAIL_SERVICE_PORT=8081

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password


# ==== Security ====

JWT_SECRET=your_base64_encoded_jwt_secret_here

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
